# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Neon connection string: Connect button in the Neon console, or `neon connection-string`
DATABASE_URL=postgresql://your_user:your_password@your-endpoint.your-region.aws.neon.tech/neondb?sslmode=verify-full
# Neon Auth base URL (public): Auth page in the Neon console, or `neon neon-auth status`
NEON_AUTH_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/neondb/auth
# Google Places API (New) key: server only, never in the frontend. Restrict it to "Places API (New)".
GOOGLE_PLACES_API_KEY=your_api_key_here
# Optional: only suggest places in this country (two-letter code, e.g. ph)
GOOGLE_PLACES_REGION=ph
