# Copy this file to .env.
# Neon Auth base URL (public, not a secret). Find it with: neon neon-auth status
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.your-region.aws.neon.tech/neondb/auth

# Dishboxd API (the Express backend) for local development. Leave it out on Vercel,
# where the site calls /api on its own address.
VITE_API_URL=http://localhost:5000
